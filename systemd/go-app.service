[Unit]
Description=Go Application Service
Wants=network-online.target kafka.service
Requires=kafka-topics.service
After=network-online.target kafka.service kafka-topics.service

[Service]
Type=simple
User=www-data
WorkingDirectory=/var/www/getreplay-go/
ExecStart=/var/www/getreplay-go/start.sh
Restart=always
RestartSec=5
StandardOutput=append:/var/log/go-app.log
StandardError=append:/var/log/go-app-error.log

[Install]
WantedBy=multi-user.target
