[Unit]
Description=GetReplay match discovery worker
Wants=network-online.target kafka.service
Requires=kafka-topics.service
After=network-online.target kafka.service kafka-topics.service

[Service]
Type=simple
User=www-data
WorkingDirectory=/var/www/getreplay-go/
ExecStart=/var/www/getreplay-go/match-discovery-worker.sh
Restart=always
RestartSec=5
TimeoutStopSec=120
UMask=0027
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictSUIDSGID=yes
LockPersonality=yes
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
