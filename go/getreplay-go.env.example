# getreplay-go runtime env — TEMPLATE.
#
# On prod copy to `getreplay-go.env` next to the launcher scripts
# (/var/www/getreplay-go/getreplay-go.env), fill the secrets, then lock it down:
#   sudo chown www-data:www-data getreplay-go.env && sudo chmod 600 getreplay-go.env
# NEVER commit the filled file (gitignored via *.env). Keep the single quotes on values
# that contain @ / ( ) etc.
#
# One shared file, sourced by every Go launcher — start.sh (match-updater),
# demo-uploader.sh, highlight-extractor-cron.sh. Each launcher adds only its own
# per-service params (ports, worker counts) on top; unused vars are ignored by the binary.

# ── secrets ──
ML_MYSQL_DSN='cs2app:CHANGE_ME@tcp(localhost:3306)/cs2'
CH_STORAGE_CLICKHOUSE_DSN='clickhouse://cs2app:CHANGE_ME@127.0.0.1:9000/cs2'
JWT_SECRET='CHANGE_ME'          # match-updater
STEAM_API_TOKEN='CHANGE_ME'     # match-updater
SERVICE_TOKEN='CHANGE_ME'       # demo-uploader (shared with PHP)

# ── shared config (non-secret) ──
ML_MYSQL_READ_TIMEOUT=2m
DOWNLOADER_TARGET_DIR=/var/www/getreplay-go/downloads
UPLOADS_DIR=/var/www/getreplay-go/downloads
MATCHUPDATER_REPLAY_DIR=/var/www/getreplay-storage/replays
REPLAY_WRITER_REPLAY_DIR=/var/www/getreplay-storage/replays
REPLAY_READER_REPLAY_DIR=/var/www/getreplay-storage/replays
REPLAY_WRITER_REPLAY_COMPRESSION=zstd
RUN=true
