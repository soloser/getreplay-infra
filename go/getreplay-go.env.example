# getreplay-go secrets — TEMPLATE.
#
# On prod, copy this to `getreplay-go.env` NEXT TO the launch scripts
# (/var/www/getreplay-go/getreplay-go.env) and fill in real values.
# NEVER commit the filled file — it is gitignored (*.env).
#
# Values can contain special chars (@, /, (), …) → keep the single quotes.
#
#   start.sh (match-updater) reads: ML_MYSQL_DSN, CH_STORAGE_CLICKHOUSE_DSN, JWT_SECRET, STEAM_API_TOKEN
#   demo-uploader.sh reads:         ML_MYSQL_DSN, CH_STORAGE_CLICKHOUSE_DSN, SERVICE_TOKEN
# (one shared file; each script uses the subset it needs, extras are ignored.)

ML_MYSQL_DSN='cs2app:CHANGE_ME@tcp(localhost:3306)/cs2'
CH_STORAGE_CLICKHOUSE_DSN='clickhouse://cs2app:CHANGE_ME@127.0.0.1:9000/cs2'
JWT_SECRET='CHANGE_ME'
STEAM_API_TOKEN='CHANGE_ME'
SERVICE_TOKEN='CHANGE_ME'
