# getreplay.gg — production Caddyfile (source of truth).
#
# Captured from prod 2026-07-26. Keep this file in sync with the server; deploy with:
#   sudo cp caddy/Caddyfile /etc/caddy/Caddyfile
#   sudo caddy validate --config /etc/caddy/Caddyfile
#   sudo systemctl reload caddy      # graceful, drains in-flight connections
#
# Topology overview: see ../docs/topology.md

# Redirect www -> naked domain
www.getreplay.gg {
    redir https://getreplay.gg{uri} 308
}

# Main site
getreplay.gg {
    tls blackangelnk@gmail.com

    @replay_embed path /admin/replay-embed /admin/replay-embed/*
    @not_replay_embed not path /admin/replay-embed /admin/replay-embed/*

    # --- Go backend ---
    handle /srv/* {
        reverse_proxy localhost:3006
    }

    # --- PHP / Laravel API ---
    handle_path /api/* {
        root * /var/www/fun-php/repo/src/public
        php_fastcgi unix//run/php/php8.4-fpm.sock
        file_server
    }

    # --- SPA frontend (zone-map-ui, Next.js on active loopback slot, IPv6-only) ---
    handle {
        encode zstd gzip
        import /var/lib/getreplay-frontend/upstream.caddy
    }

    # --- Security headers ---
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "no-referrer-when-downgrade"
        # Content-Security-Policy "default-src 'self' 'unsafe-inline' data:; img-src 'self' data: https:; connect-src 'self' https: ws:;"
    }

    header @not_replay_embed {
        X-Frame-Options "DENY"
    }

    # Replay embed pages are meant to be iframed by app.getreplay.gg
    header @replay_embed {
        -X-Frame-Options
        Content-Security-Policy "frame-ancestors https://app.getreplay.gg"
    }
}

# Product app + Laravel / Orchid admin under /backend
app.getreplay.gg {
    tls blackangelnk@gmail.com
    encode zstd gzip

    @demo_upload {
        path /backend/demo-library/uploadSingleAction /backend/demo-library/uploadBulkAction
    }
    @orchid_dynamic {
        path /backend /backend/* /up
    }
    @orchid_static {
        path /vendor/orchid/* /storage/*
    }
    @orchid_frame {
        path /backend /backend/* /vendor/orchid/* /storage/*
    }
    @not_orchid_frame {
        not path /backend /backend/* /vendor/orchid/* /storage/*
    }

    # Demo archives can be large. Relax the limit only for the two admin upload
    # actions and keep every other Orchid request on the normal limit.
    handle @demo_upload {
        root * /var/www/fun-php/repo/src/public
        request_body {
            max_size 8GiB
        }
        php_fastcgi unix//run/php/php8.4-fpm.sock {
            env PHP_VALUE "upload_max_filesize=2G"
            env PHP_ADMIN_VALUE "post_max_size=8G"
        }
        file_server
    }

    handle @orchid_dynamic {
        root * /var/www/fun-php/repo/src/public
        request_body {
            max_size 64MiB
        }
        php_fastcgi unix//run/php/php8.4-fpm.sock
        file_server
    }

    handle @orchid_static {
        root * /var/www/fun-php/repo/src/public
        file_server
    }

    # Same-origin application backends. OAuth itself still starts on
    # getreplay.gg so its host-scoped provider session survives the callback.
    handle /srv/* {
        reverse_proxy localhost:3006
    }

    handle_path /api/* {
        root * /var/www/fun-php/repo/src/public
        php_fastcgi unix//run/php/php8.4-fpm.sock
        file_server
    }

    # Everything outside the explicit Orchid/backend paths is the product app.
    handle {
        import /var/lib/getreplay-frontend/upstream.caddy
    }

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "no-referrer-when-downgrade"
        X-Robots-Tag "noindex, nofollow"
    }

    header @not_orchid_frame {
        X-Frame-Options "DENY"
    }

    header @orchid_frame {
        X-Frame-Options "SAMEORIGIN"
    }
}

# Storage subdomain (replays + Laravel public storage)
storage.getreplay.gg {
    encode zstd gzip
    tls blackangelnk@gmail.com

    @cors_preflight method OPTIONS
    handle @cors_preflight {
        header Access-Control-Allow-Origin "*"
        header Access-Control-Allow-Methods "GET, HEAD, OPTIONS"
        header Access-Control-Allow-Headers "Range, Content-Type"
        header Access-Control-Expose-Headers "Accept-Ranges, Content-Range, Content-Length, Content-Type"
        respond "" 204
    }

    # Uncompressed .replay2 blobs
    @replay2 path /replays/*.replay2
    handle @replay2 {
        root * /var/www/getreplay-storage
        header Access-Control-Allow-Origin "*"
        header Access-Control-Allow-Methods "GET, HEAD, OPTIONS"
        header Access-Control-Allow-Headers "Range, Content-Type"
        header Access-Control-Expose-Headers "Accept-Ranges, Content-Range, Content-Length, Content-Type"
        header Content-Type application/octet-stream
        header -Content-Encoding
        file_server
    }

    # gzip-encoded replays
    handle_path /replays/* {
        root * /var/www/getreplay-storage/replays
        header Access-Control-Allow-Origin "*"
        header Access-Control-Allow-Methods "GET, HEAD, OPTIONS"
        header Access-Control-Allow-Headers "Range, Content-Type"
        header Access-Control-Expose-Headers "Accept-Ranges, Content-Range, Content-Length, Content-Type"
        header Content-Encoding gzip
        header Content-Type application/octet-stream
        file_server
    }

    # Laravel public storage (images, etc.)
    handle {
        root * /var/www/fun-php/repo/src/storage/app/public
        header Access-Control-Allow-Origin "*"
        header Access-Control-Allow-Methods "GET, HEAD, OPTIONS"
        header Access-Control-Allow-Headers "Range, Content-Type"
        header Access-Control-Expose-Headers "Accept-Ranges, Content-Range, Content-Length, Content-Type"
        header Cache-Control "public, max-age=31536000, immutable"
        header Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        header X-Content-Type-Options "nosniff"
        file_server
    }
}
