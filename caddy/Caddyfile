# getreplay.gg — production Caddyfile (source of truth).
#
# Captured from prod 2026-07-26. Keep this file in sync with the server; deploy with:
#   sudo cp caddy/Caddyfile /etc/caddy/Caddyfile
#   sudo caddy validate --config /etc/caddy/Caddyfile
#   sudo systemctl reload caddy      # graceful, drains in-flight connections
#
# Topology overview: see ../docs/topology.md

# Redirect www -> naked domain
www.getreplay.gg {
    redir https://getreplay.gg{uri} 308
}

# Main site
getreplay.gg {
    tls admin@getreplay.gg

    @replay_embed path /admin/replay-embed /admin/replay-embed/*
    @not_replay_embed not path /admin/replay-embed /admin/replay-embed/*

    # --- Go backend ---
    handle /srv/* {
        reverse_proxy localhost:3006
    }

    # --- PHP / Laravel API ---
    handle_path /api/* {
        root * /var/www/fun-php/repo/src/public
        php_fastcgi unix//run/php/php8.4-fpm.sock
        file_server
    }

    # --- SPA frontend (zone-map-ui, Next.js on active loopback slot, IPv6-only) ---
    handle {
        encode zstd gzip
        import /var/lib/getreplay-frontend/upstream.caddy
    }

    # --- Security headers ---
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "no-referrer-when-downgrade"
        # Content-Security-Policy "default-src 'self' 'unsafe-inline' data:; img-src 'self' data: https:; connect-src 'self' https: ws:;"
    }

    header @not_replay_embed {
        X-Frame-Options "DENY"
    }

    # Replay embed pages are meant to be iframed by app.getreplay.gg
    header @replay_embed {
        -X-Frame-Options
        Content-Security-Policy "frame-ancestors https://app.getreplay.gg"
    }
}

# Laravel / Orchid admin
app.getreplay.gg {
    tls admin@getreplay.gg
    encode zstd gzip

    root * /var/www/fun-php/repo/src/public

    @demo_upload {
        path /backend/demo-library/uploadSingleAction /backend/demo-library/uploadBulkAction
    }
    @regular_admin_request {
        not path /backend/demo-library/uploadSingleAction /backend/demo-library/uploadBulkAction
    }

    route {
        # Demo archives can be large. Relax the limit only for the two admin
        # upload actions and keep every other admin request on the normal limit.
        request_body @demo_upload {
            max_size 8GiB
        }
        request_body @regular_admin_request {
            max_size 64MiB
        }
        php_fastcgi @demo_upload unix//run/php/php8.4-fpm.sock {
            env PHP_VALUE "upload_max_filesize=2G"
            env PHP_ADMIN_VALUE "post_max_size=8G"
        }
        php_fastcgi unix//run/php/php8.4-fpm.sock
        file_server
    }

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "no-referrer-when-downgrade"
        # Для админки часто лучше не DENY, если Orchid где-то использует iframe/встраивание — но обычно можно оставить
        X-Frame-Options "SAMEORIGIN"
    }
}

# Public file origins for Timeweb pull CDN. HTML/API/auth stay on getreplay.gg.
# CORS also permits fonts, canvas exports and replay byte ranges through CDN.
(cdn_public_headers) {
    header {
        Access-Control-Allow-Origin "*"
        Access-Control-Allow-Methods "GET, HEAD, OPTIONS"
        Access-Control-Allow-Headers "Range, Content-Type"
        Access-Control-Expose-Headers "Accept-Ranges, Content-Range, Content-Length, Content-Type, ETag"
        X-Content-Type-Options "nosniff"
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
    }
    header {
        Cache-Control "no-store"
        match status 4xx 5xx
    }
    @cors_preflight method OPTIONS
    handle @cors_preflight {
        header Cache-Control "no-store"
        respond "" 204
    }
    @unsupported_method not method GET HEAD OPTIONS
    handle @unsupported_method {
        header Cache-Control "no-store"
        respond "Method not allowed" 405
    }
    handle_errors {
        header Access-Control-Allow-Origin "*"
        header Cache-Control "no-store"
        header -Content-Encoding
        respond "{err.status_code} {err.status_text}" {err.status_code}
    }
}

# DNS A/AAAA points here; CDN domain is static.getreplay.gg.
assets-origin.getreplay.gg {
    tls blackangelnk@gmail.com
    import cdn_public_headers

    # Keep Next's image optimization. Every query parameter is part of the CDN
    # cache key. A stable Accept avoids mixed WebP/AVIF cache entries.
    @optimized_image path_regexp optimized ^/releases/[a-zA-Z0-9][a-zA-Z0-9_-]{0,95}/_next/image$
    handle @optimized_image {
        rewrite * /_next/image
        request_header Accept image/webp
        request_header -Cookie
        request_header -Authorization
        import /var/lib/getreplay-frontend/upstream.caddy
    }

    @release_file path_regexp release ^/releases/[a-zA-Z0-9][a-zA-Z0-9_-]{0,95}/(_next/static|public)/.+$
    handle @release_file {
        root * /var/lib/getreplay-frontend/assets
        header Cache-Control "public, max-age=31536000, immutable" {
            match status 2xx 304
        }
        encode zstd gzip
        file_server {
            hide *.map .*
        }
    }
    handle {
        header Cache-Control "no-store"
        respond "Not found" 404
    }
}

# DNS points here; CDN domain is media.getreplay.gg.
storage.getreplay.gg {
    tls blackangelnk@gmail.com
    import cdn_public_headers

    # Storage names can be reused during reprocessing. Keep a bounded TTL.
    header Cache-Control "public, max-age=3600" {
        match status 200 206 304
    }

    # Do not dynamically compress range-addressed replay files.
    @replay2 path /replays/*.replay2
    handle @replay2 {
        root * /var/www/getreplay-storage
        header Content-Type application/octet-stream
        header -Content-Encoding
        file_server
    }
    # Existing legacy replay objects contain gzip bytes.
    handle_path /replays/* {
        root * /var/www/getreplay-storage/replays
        header Content-Encoding gzip
        header Content-Type application/octet-stream
        file_server
    }
    handle {
        root * /var/www/fun-php/repo/src/storage/app/public
        file_server
    }
}
